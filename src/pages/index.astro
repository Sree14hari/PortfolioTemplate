<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Avanthika T — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Top Hero Area with Lavender Background -->
    <div class="hero-wrapper">
      <div class="page-container">
        <!-- Floating Navigation Bar -->
        <header class="nav-wrapper">
          <nav class="nav-pill" id="navPill">
            <!-- Logo / Brand Name -->
            <a href="#" class="brand-name">Avanthika</a>

            <!-- Center Navigation Links -->
            <ul class="nav-links" id="navLinks">
              <li><a href="#home" class="nav-link">Home</a></li>
              <li class="separator">·</li>
              <li><a href="#works" class="nav-link">Works</a></li>
              <li class="separator">·</li>
              <li><a href="#about" class="nav-link">About</a></li>
              <li class="separator">·</li>
              <li><a href="#journey" class="nav-link">Journey</a></li>
              <li class="separator">·</li>
              <li><a href="mailto:avanthikatajith@gmail.com" class="nav-link">Contact</a></li>
            </ul>

            <!-- Right Action / Social Icons: Instagram & LinkedIn only -->
            <div class="nav-actions">
              <a
                href="https://www.instagram.com/avanthikat08/"
                target="_blank"
                rel="noopener noreferrer"
                class="icon-btn"
                aria-label="Instagram Profile"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>

              <a
                href="https://www.linkedin.com/in/avanthika08t"
                target="_blank"
                rel="noopener noreferrer"
                class="icon-btn"
                aria-label="LinkedIn Profile"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="15"
                  height="15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
