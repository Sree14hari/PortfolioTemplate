                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
              </button>
            </div>
          </nav>
        </header>

        <!-- Hero Main Section -->
        <main class="hero-section" id="home">
          <!-- Floating Sticker 1: Top-Left "Embedded Systems" -->
          <div class="sticker sticker-top-left" aria-hidden="true">
            <img
              src="/illustrations/sparkle.svg"
              alt=""
              class="illustration-sparkle"
              draggable="false"
            />

            <div class="pill-badge pill-blue">
              <span>Embedded Systems</span>
            </div>

            <img
              src="/illustrations/lines.svg"
              alt=""
              class="illustration-lines-left"
              draggable="false"
            />
          </div>

          <!-- Floating Sticker 2: Bottom-Left Pencil & Heart trail -->
          <div class="sticker sticker-bottom-left" aria-hidden="true">
            <img
              src="/illustrations/pencil.svg"
              alt=""
              class="illustration-pencil"
              draggable="false"
            />
          </div>

          <!-- Floating Sticker 3: Top-Right Hand-Drawn Curved Arrow -->
          <div class="sticker sticker-top-right" aria-hidden="true">
            <img
              src="/illustrations/arrow.svg"
              alt=""
              class="illustration-arrow"
              draggable="false"
            />
          </div>

          <!-- Floating Sticker 4: Bottom-Right "IoT & Robotics" -->
          <div class="sticker sticker-bottom-right" aria-hidden="true">
            <img
              src="/illustrations/handpeace.svg"
              alt=""
              class="illustration-handpeace"
              draggable="false"
            />

            <div class="pill-badge pill-pink">
              <span>IoT & Robotics</span>
            </div>

            <img
              src="/illustrations/lines.svg"
              alt=""
              class="illustration-lines-right"
              draggable="false"
            />
          </div>

          <!-- Center Content -->
          <div class="hero-content">
            <!-- Line 1: Hello! [avatar] I'm Avanthika. -->
            <h1 class="hero-heading">
              <div class="heading-row">
                <span class="greeting-word">Hello!</span>
                <div class="avatar-frame">
                  <img
                    src="/dp.png"
                    alt="Avanthika T"
                    class="avatar-image"
                    loading="eager"
                  />
                </div>
                <span class="name-word">I'm Avanthika.</span>
              </div>
              <!-- Line 2: an engineer & innovator. -->
              <div class="heading-sub">an engineer & innovator.</div>
            </h1>

            <!-- Bio Paragraph matching Meeko's phrasing and highlights -->
            <p class="hero-description">
              My focus is on cultivating smart solutions through the creation of
              innovative systems that <strong>explore embedded hardware</strong>,
              and <strong>IoT-related</strong> topics.
            </p>
          </div>
        </main>
      </div>
    </div>

    <!-- 3-Card Showcase Section (Portfolio, About, Contact) -->
    <section class="cards-section" id="cards">
      <!-- Background purple reaching down to the exact vertical center of the cards with wave -->
      <div class="cards-bg-split" aria-hidden="true">
        <div class="split-purple"></div>
        <div class="split-wave">
          <svg viewBox="0 0 1440 70" fill="none" preserveAspectRatio="none">
            <path
              d="M0,30 C320,60 540,10 760,35 C1000,65 1220,15 1440,35 L1440,90 L0,90 Z"
              fill="#ffffff"
            ></path>
          </svg>
        </div>
      </div>

      <div class="cards-container">
        <!-- Card 1: My Journey -->
        <div class="feature-card" id="journey-card">
          <div class="card-icon-wrapper">
            <img
              src="/illustrations/card-portfolio.svg"
              alt="My Journey"
              class="card-icon-img"
              draggable="false"
            />
          </div>
          <h2 class="card-title">My Journey</h2>
          <p class="card-description">
            Explore my engineering timeline, milestones, hackathons, and experience.
          </p>
          <a
            href="#journey"
            class="card-arrow-btn btn-blue"
            aria-label="View My Journey"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1a1a1a"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Card 2: About / Journal -->
        <div class="feature-card" id="about">
          <div class="card-icon-wrapper">
            <img
              src="/illustrations/card-journal.svg"
              alt="About Me"
              class="card-icon-img"
              draggable="false"
            />
          </div>
          <h2 class="card-title">About Me</h2>
          <p class="card-description">
            Final-year ECE student sharing insights on embedded hardware, IoT, and tech.
          </p>
          <a
            href="https://www.linkedin.com/in/avanthika08t"
            target="_blank"
            rel="noopener noreferrer"
            class="card-arrow-btn btn-yellow"
            aria-label="Read About Me"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1a1a1a"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Card 3: Contact Me -->
        <div class="feature-card" id="contact">
          <div class="card-icon-wrapper">
            <img
              src="/illustrations/card-contact.svg"
              alt="Contact Me"
              class="card-icon-img"
              draggable="false"
            />
          </div>
          <h2 class="card-title">Contact Me</h2>
          <p class="card-description">
            If you like what you see, let’s work to bring your vision to life.
          </p>
          <a
            href="mailto:avanthikatajith@gmail.com"
            class="card-arrow-btn btn-mint"
            aria-label="Send an email"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1a1a1a"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>


    <!-- Selected Works Section -->
    <section class="selected-works-section" id="works">
      <div class="works-header">
        <h2 class="works-title">My selected works</h2>
        <p class="works-subtitle">
          With a strong foundation in electronics and embedded engineering, I specialize
          in developing intelligent <strong>hardware systems</strong>, <strong>IoT devices</strong>, and <span class="highlight-wrapper"><strong>deep learning models</strong>.<svg class="scribble-underline" width="140" height="18" viewBox="0 0 140 18" fill="none"><path d="M4 10 C25 5 45 15 65 9 C78 5 80 15 88 15 C96 15 98 7 106 9 C118 13 130 6 138 10" stroke="#1D1D1D" stroke-width="1.8" stroke-linecap="round"/><path d="M75 9 C72 4 82 3 84 8 C86 13 77 16 73 11 C70 7 79 5 86 8" stroke="#1D1D1D" stroke-width="1.5" stroke-linecap="round"/></svg></span>
        </p>
      </div>

      <div class="works-container">
        <!-- Work Card 1: Microplastic Detection -->
        <article class="work-card">
          <div class="work-info">
            <h3 class="work-card-title">
              Portable Fluorescent Imaging–Based Microplastic Detection System for Freshwater Bodies Using ESP32
            </h3>
            <div class="work-card-tags">EMBEDDED SYSTEMS, IOT, HARDWARE</div>
            <p class="work-card-desc">
              A low-cost, field-deployable fluorescent imaging apparatus driven by an ESP32 microcontroller, engineered for automated in-situ detection and monitoring of microplastic contaminants across freshwater aquatic ecosystems.
            </p>
            <a
              href="https://github.com/avanthikat08"
              target="_blank"
              rel="noopener noreferrer"
              class="work-view-btn"
            >
              See Project
            </a>
          </div>
          <div class="work-image-wrapper">
            <img
              src="/project/microplastic.png"
              alt="Portable Fluorescent Imaging–Based Microplastic Detection System for Freshwater Bodies Using ESP32"
              class="work-card-image"
              loading="lazy"
            />
          </div>
        </article>

        <!-- Work Card 2: Bharatanatyam Mudra Recognition -->
        <article class="work-card">
          <div class="work-info">
            <h3 class="work-card-title">
              Hybrid Deep Learning Model for Bharatanatyam Mudra Recognition
            </h3>
            <div class="work-card-tags">AI, COMPUTER VISION, DEEP LEARNING</div>
            <p class="work-card-desc">
              An advanced computer vision framework integrating CNN spatial feature extraction and sequence modeling to accurately classify and recognize intricate classical Bharatanatyam hand mudras in real-time.
            </p>
            <a
              href="https://github.com/avanthikat08"
              target="_blank"
              rel="noopener noreferrer"
              class="work-view-btn"
            >
              See Project
            </a>
          </div>
          <div class="work-image-wrapper">
            <img
              src="/project/mudra.png"
              alt="Hybrid Deep Learning Model for Bharatanatyam Mudra Recognition"
              class="work-card-image"
              loading="lazy"
            />
          </div>
        </article>
      </div>
    </section>


    <!-- Internships Section -->
    <section class="internships-section" id="internships">
      <div class="internships-header">
        <h2 class="internships-title">Internship Experience</h2>
        <p class="internships-subtitle">
          Hands-on industry training and technical experience in embedded hardware, robotics, and industrial electronics.
        </p>
      </div>

      <div class="internships-container">
        <!-- Internship Card 1: SinroRobotics -->
        <article class="internship-card">
          <div class="internship-badge-row">
            <span class="internship-pill pill-blue">Embedded Systems & Robotics</span>
            <span class="internship-type">Academic Internship</span>
          </div>
          <h3 class="internship-role">Academic Internship in Embedded Systems</h3>
          <h4 class="internship-company">SinroRobotics Pvt. Ltd.</h4>
          <p class="internship-desc">
            Focused on hardware-software co-design, developing embedded firmware, sensor-actuator interfacing, and real-time microcontroller applications for robotic automation systems.
          </p>
          <ul class="internship-points">
            <li>
              <span class="bullet-icon">✦</span>
              <span>Programmed and tested embedded microcontrollers for intelligent automation.</span>
            </li>
            <li>
              <span class="bullet-icon">✦</span>
              <span>Interfaced multi-sensor modules and actuators with real-time feedback loops.</span>
            </li>
            <li>
              <span class="bullet-icon">✦</span>
              <span>Conducted hardware debugging, circuit verification, and prototype testing.</span>
            </li>
          </ul>
        </article>

        <!-- Internship Card 2: KELTRON -->
        <article class="internship-card">
          <div class="internship-badge-row">
            <span class="internship-pill pill-yellow">Industrial Electronics</span>
            <span class="internship-type">Govt of Kerala Undertaking</span>
          </div>
          <h3 class="internship-role">Internship at KELTRON</h3>
          <h4 class="internship-company">Kerala State Electronics Development Corporation Ltd.</h4>
          <p class="internship-desc">
            Industrial training at KELTRON – a premier Government of Kerala undertaking, studying industrial electronics manufacturing, PCB production, quality control, and electronic assembly processes.
          </p>
          <ul class="internship-points">
            <li>
              <span class="bullet-icon">✦</span>
              <span>Observed large-scale electronics manufacturing workflows and standardized QA testing.</span>
            </li>
            <li>
              <span class="bullet-icon">✦</span>
              <span>Gained insights into industrial control hardware, PCB fabrication, and power electronics.</span>
            </li>
            <li>
              <span class="bullet-icon">✦</span>
              <span>Studied state-level public sector engineering standards and regulatory compliance.</span>
            </li>
          </ul>
        </article>
      </div>
    </section>


    <!-- Transition Wave to Purple Background -->
    <div class="journey-wave-top" aria-hidden="true">
      <svg viewBox="0 0 1440 80" fill="none" preserveAspectRatio="none">
        <path
