          fill="#e3e3ff"
        ></path>
      </svg>
    </div>

    <!-- My Journey Section (Left-to-Right Horizontal Scrollable Cards) -->
    <section class="journey-section" id="journey">
      <div class="journey-header">
        <div class="journey-header-text">
          <h2 class="journey-title">My Journey</h2>
          <p class="journey-subtitle">
            Key hackathons, internships, technical initiatives, and leadership milestones along my engineering path.
          </p>
        </div>
        <!-- Left / Right Scroll Control Buttons -->
        <div class="journey-controls" aria-label="Timeline navigation">
          <button class="journey-scroll-btn" id="journeyPrev" aria-label="Scroll left">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1a1a1a"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button class="journey-scroll-btn" id="journeyNext" aria-label="Scroll right">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1a1a1a"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Scrollable Track Wrapper -->
      <div class="journey-carousel-wrapper">
        <div class="journey-scroll-track" id="journeyTrack">
          <!-- Card 1: Nov 2025 -->
          <article class="journey-h-card">
            <div class="stop-header">
              <span class="stop-date pill-blue">Nov 2025</span>
              <span class="stop-category">Global Hackathon</span>
            </div>
            <h3 class="stop-title">NASA Space Apps Challenge</h3>
            <p class="stop-desc">
              Competed in the world's largest annual space & science hackathon, collaborating on creative technical solutions tackling terrestrial and space exploration challenges using open NASA data.
            </p>
          </article>

          <!-- Card 2: Dec 2025 -->
          <article class="journey-h-card">
            <div class="stop-header">
              <span class="stop-date pill-yellow">Dec 2025</span>
              <span class="stop-category">Industrial Training</span>
            </div>
            <h3 class="stop-title">KELTRON Internship</h3>
            <p class="stop-desc">
              Completed industrial electronics internship at Kerala State Electronics Development Corporation Ltd. (KELTRON), gaining firsthand experience in industrial electronic assembly, PCB manufacturing, and quality control.
            </p>
          </article>

          <!-- Card 3: Jan 2026 -->
          <article class="journey-h-card">
            <div class="stop-header">
              <span class="stop-date pill-pink">Jan 2026</span>
              <span class="stop-category">IIT Dhanbad</span>
            </div>
            <h3 class="stop-title">Predict2Protect</h3>
            <p class="stop-desc">
              Participated in the Predict2Protect initiative conducted by IIT (ISM) Dhanbad, focusing on machine learning-based proactive threat mitigation, predictive intelligence, and cybersecurity frameworks.
            </p>
          </article>

          <!-- Card 4: March 2026 -->
          <article class="journey-h-card">
            <div class="stop-header">
              <span class="stop-date pill-mint">March 2026</span>
              <span class="stop-category">Volunteering</span>
            </div>
            <h3 class="stop-title">Volunteered at Open Source Quest</h3>
            <p class="stop-desc">
              Contributed as a community volunteer for Open Source Quest, promoting accessible collaborative development, assisting contributors, and organizing tech workshops for students.
            </p>
          </article>

          <!-- Card 5: June 2026 -->
          <article class="journey-h-card card-highlight">
            <div class="stop-header">
              <span class="stop-date pill-blue">June 2026</span>
              <span class="stop-category">Robotics & Firmware</span>
            </div>
            <h3 class="stop-title">Academic Internship in Embedded Systems</h3>
            <h4 class="stop-subtitle">SinroRobotics Pvt. Ltd.</h4>
            <p class="stop-desc">
              Intensive academic internship developing microcontroller firmware, sensor-actuator feedback control, and real-time embedded hardware prototyping for robotic applications.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Transition Wave to Dark Footer -->
    <div class="footer-wave-wrapper" aria-hidden="true">
      <svg class="footer-wave-svg" viewBox="0 0 1440 90" fill="none" preserveAspectRatio="none">
        <!-- Main Dark Fill Overlaying Purple Background -->
